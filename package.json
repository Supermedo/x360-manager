{
  "name": "x360-manager",
  "version": "1.6.4",
  "description": "A modern game manager for Xbox 360 emulation with download and configuration features",
  "author": "X360 Team",
  "main": "electron.js",
  "homepage": "./",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Supermedo/x360-manager.git"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "crc-32": "^1.2.2",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.1.7",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "steam-shortcut-editor": "^3.1.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^22.0.0",
    "electron-builder": "^23.6.0",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1",
    "sharp": "^0.34.5",
    "wait-on": "^9.0.10"
  },
  "scripts": {
    "ensure-utf8": "node scripts/ensure-utf8.cjs",
    "prestart": "node scripts/ensure-utf8.cjs",
    "start": "react-scripts start",
    "icons": "node scripts/generate-icons.js",
    "build": "npm run icons && react-scripts build && node scripts/copy-icons-to-build.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "node node_modules/electron/cli.js .",
    "electron-dev": "cross-env ELECTRON_IS_DEV=1 node node_modules/electron/cli.js .",
    "dev": "node scripts/ensure-utf8.cjs && npm run icons && concurrently -k -n REACT,ELECTRON -c blue,magenta \"cross-env BROWSER=none npm start\" \"wait-on -d 1500 http://localhost:3000 && cross-env ELECTRON_IS_DEV=1 node node_modules/electron/cli.js .\"",
    "dev:built": "npm run build && cross-env ELECTRON_FORCE_BUILD=1 node node_modules/electron/cli.js .",
    "electron-build": "electron-builder",
    "dist": "npm run icons && npm run build && node scripts/electron-dist.js",
    "dist:direct": "npm run icons && npm run build && electron-builder",
    "build-portable": "npm run build && electron-builder --win --dir --publish=never",
    "build-setup": "npm run build-portable && node scripts/create-setup.js",
    "build-all": "npm run build && electron-builder --win --mac --linux --publish=never"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.x360manager.app",
    "productName": "X360 Manager",
    "directories": {
      "output": "dist-setup",
      "buildResources": "resources"
    },
    "afterPack": "scripts/afterPack.cjs",
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "resources/icon.ico",
      "resources/icon.png",
      "electron.js",
      "preload.js",
      "appUpdater.js",
      "appStorage.js",
      "xeniaLaunch.js",
      "xeniaConfig.js",
      "xeniaLanguageShared.js",
      "gameLanguageProbe.js",
      "xboxLiveProfiles.js",
      "patchHelpers.js",
      "fpsOverlay.js",
      "fpsOverlay.html",
      "fpsOverlayPreload.js",
      "!node_modules/.cache",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraMetadata": {
      "main": "electron.js"
    },
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "Supermedo",
        "repo": "x360-manager",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "shortcutName": "X360 Manager",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "Games",
      "displayLanguageSelector": false,
      "warningsAsErrors": false
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "icon.ico",
      "executableName": "X360 Manager",
      "publisherName": "X360 Team",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "X360-Manager-Setup-${version}.${ext}",
      "sign": null,
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "public/icon.png",
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "target": {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      "icon": "public/icon.png",
      "category": "Game"
    },
    "fileAssociations": [
      {
        "ext": "iso",
        "name": "Xbox 360 Game Image",
        "description": "Xbox 360 Game ISO File",
        "role": "Editor"
      }
    ]
  }
}
